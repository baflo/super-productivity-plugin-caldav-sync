{
  "id": "caldav-sync",
  "name": "CalDAV Schedule Sync",
  "version": "2.1.2",
  "description": "Synchronizes scheduled tasks (dueWithTime/dueDay) to a CalDAV calendar",
  "manifestVersion": 1,
  "minSupVersion": "16.8.3",
  "author": "Florian",
  "jsonSchemaCfg": "config.schema.json",
  "hooks": [
    "taskCreated",
    "taskUpdate",
    "taskDelete",
    "taskComplete"
  ],
  "permissions": [
    "getTasks",
    "getArchivedTasks",
    "showSnack"
  ]
}
