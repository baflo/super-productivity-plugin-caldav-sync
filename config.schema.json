{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "CalDAV Sync Settings",
  "properties": {
    "calendarUrl": {
      "type": "string",
      "title": "CalDAV Calendar URL",
      "description": "Must end with /. Example: https://cloud.com/remote.php/dav/calendars/username/calendar/"
    },
    "username": {
      "type": "string",
      "title": "Username"
    },
    "password": {
      "type": "string",
      "title": "Password / App Password",
      "description": "For Nextcloud: Create an app password in the security settings",
      "format": "password"
    },
    "enabled": {
      "type": "boolean",
      "title": "Enable auto sync",
      "default": false
    },
    "deleteCompletedTasks": {
      "type": "boolean",
      "title": "Delete completed tasks from calendar",
      "description": "When enabled, completed tasks are automatically removed from the calendar",
      "default": false
    }
  },
  "required": ["calendarUrl", "username", "password"]
}
